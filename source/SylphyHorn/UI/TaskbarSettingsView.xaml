<UserControl x:Class="SylphyHorn.UI.TaskbarSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:metro="http://schemes.grabacr.net/winfx/2014/controls"
             xmlns:serialization="clr-namespace:SylphyHorn.Serialization">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/SylphyHorn;component/UI/SettingsPageResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style x:Key="Label" TargetType="TextBlock">
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Margin" Value="0,0,8,0" />
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<!-- See AppPlacementSettingsView: templated text would otherwise inherit the selected tab item's accent foreground. -->
		<StackPanel Margin="16,0,16,16" Focusable="True" TextElement.Foreground="{DynamicResource ForegroundBrushKey}">
			<!-- Each place the current desktop can be shown has a switch, with its options indented below it. -->
			<TextBlock Text="{Binding Text[Title]}" Style="{DynamicResource HeaderStyleKey}" />
			<TextBlock Text="{Binding Text[Unavailable]}"
					   Style="{StaticResource InlineMessage}"
					   Visibility="{Binding IsUnavailable, Converter={StaticResource Visible}}"
					   Margin="8,0,0,8" />
			<CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="8,0,0,8">
				<TextBlock Text="{Binding Text[Enable]}" />
			</CheckBox>
			<Grid Margin="29,0,0,0" IsEnabled="{Binding IsEnabled}">
				<Grid.Style>
					<!-- The combo boxes look the same when disabled, so dim the whole block. -->
					<Style TargetType="Grid">
						<Style.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="110" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock Text="{Binding Text[PlacementLabel]}" Style="{StaticResource Label}" />
				<metro:PromptComboBox Grid.Column="1"
									  ItemsSource="{Binding Placements}"
									  DisplayMemberPath="Display"
									  SelectedValuePath="Value"
									  SelectedValue="{Binding Placement, Mode=TwoWay}"
									  Prompt=""
									  IsReadOnly="True"
									  MinWidth="280"
									  HorizontalAlignment="Left" />
				<TextBlock Grid.Row="1"
						   Grid.Column="1"
						   Text="{Binding Text[PlacementHint]}"
						   Style="{StaticResource InlineMessage}"
						   Margin="0,4,0,10" />

				<TextBlock Grid.Row="2" Text="{Binding Text[FontFamily]}" Style="{StaticResource Label}" />
				<metro:PromptComboBox Grid.Row="2"
									  Grid.Column="1"
									  ItemsSource="{Binding FontFamilies}"
									  DisplayMemberPath="Display"
									  SelectedValuePath="Value"
									  SelectedValue="{Binding FontFamily, Mode=TwoWay}"
									  Prompt=""
									  IsReadOnly="True"
									  MinWidth="280"
									  Margin="0,0,0,8"
									  HorizontalAlignment="Left" />

				<TextBlock Grid.Row="3" Text="{Binding Text[FontSize]}" Style="{StaticResource Label}" />
				<metro:PromptComboBox Grid.Row="3"
									  Grid.Column="1"
									  ItemsSource="{Binding FontSizes}"
									  SelectedItem="{Binding FontSize, Mode=TwoWay}"
									  Prompt=""
									  IsReadOnly="True"
									  MinWidth="70"
									  Margin="0,0,0,8"
									  HorizontalAlignment="Left" />

				<TextBlock Grid.Row="4" Text="{Binding Text[ColorLabel]}" Style="{StaticResource Label}" />
				<CheckBox Grid.Row="4"
						  Grid.Column="1"
						  IsChecked="{Binding IsAutomaticColor, Mode=TwoWay}"
						  Margin="0,0,0,6">
					<TextBlock Text="{Binding Text[AutomaticColor]}" />
				</CheckBox>
				<StackPanel Grid.Row="5"
							Grid.Column="1"
							Orientation="Horizontal"
							IsEnabled="{Binding IsAutomaticColor, Converter={StaticResource ReverseBooleanConverter}}">
					<metro:PromptTextBox Text="{Binding TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										 Prompt="#RRGGBB"
										 Width="90" />
					<Border Width="24"
							Height="24"
							Margin="8,0"
							Background="{Binding TextColorPreview}"
							BorderBrush="{DynamicResource BorderBrushKey}"
							BorderThickness="1" />
					<Button Content="{Binding Text[ChooseColor]}"
							Click="ChooseColor"
							MinWidth="80" />
				</StackPanel>
			</Grid>

			<StackPanel Style="{StaticResource Section}">
				<TextBlock Text="{Binding Text[TraySection]}" Style="{DynamicResource HeaderStyleKey}" />
				<CheckBox IsChecked="{Binding Source={x:Static serialization:Settings.General}, Path=TrayShowDesktop.Value, Mode=TwoWay}"
						  Margin="8,0,0,0">
					<TextBlock Text="{Binding Text[TrayShow]}" />
				</CheckBox>
				<CheckBox IsChecked="{Binding Source={x:Static serialization:Settings.General}, Path=TrayShowOnlyCurrentNumber.Value, Mode=TwoWay}"
						  IsEnabled="{Binding Source={x:Static serialization:Settings.General}, Path=TrayShowDesktop.Value, Mode=OneWay}"
						  Margin="29,4,0,0">
					<TextBlock Text="{Binding Text[TrayNumberOnly]}" />
				</CheckBox>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
